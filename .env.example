NEXT_PUBLIC_SITE_URL=http://localhost:3000
# local keeps the file database for `npm run dev` without Docker.
# supabase is required on Vercel. Apply supabase/migrations before using it.
DATA_PROVIDER=local

# Public. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=replace-with-at-least-16-characters
CRON_SECRET=replace-with-a-long-random-string
CONTACT_INBOX_EMAIL=editors@example.com
EMAIL_FROM=
RESEND_API_KEY=
SECURITY_EMAIL=security@example.com
RATE_LIMIT_PEPPER=replace-me
